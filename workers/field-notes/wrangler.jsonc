{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zouantcha-field-notes",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "0bb05130da965c096b12cc1f0637f763",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zouantcha-field-notes",
      "database_id": "c47d87c8-911e-4330-a59b-bd4f817a69a9",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "api.zouantcha.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_ENV": "production",
    "BUILD_LOG_MAIL_MODE": "live",
    "BUILD_LOG_PUBLIC_URL": "https://www.zouantcha.com",
    "EMAIL_SENDER_APPROVED": "yes",
    "EMAIL_FROM": "wiel@notify.zouantcha.com",
    "EMAIL_EXPECTED_FROM": "wiel@notify.zouantcha.com",
    "EMAIL_REPLY_TO": "zouantchaw74@gmail.com",
    "EMAIL_RECIPIENT_POLICY": "confirmed-public",
    "ISSUE_SEND_MODE": "disabled"
  },
  "env": {
    "staging": {
      "name": "zouantcha-field-notes-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "SITE_ENV": "staging",
        "BUILD_LOG_MAIL_MODE": "live",
        "BUILD_LOG_PUBLIC_URL": "https://zouantcha-site-staging.wiel.workers.dev",
        "EMAIL_SENDER_APPROVED": "yes",
        "EMAIL_FROM": "wiel@notify.zouantcha.com",
        "EMAIL_EXPECTED_FROM": "wiel@notify.zouantcha.com",
        "EMAIL_REPLY_TO": "zouantchaw74@gmail.com",
        "EMAIL_RECIPIENT_POLICY": "allowlist",
        "EMAIL_ALLOWED_RECIPIENTS": "zouantchaw74@gmail.com",
        "ISSUE_SEND_MODE": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zouantcha-field-notes-staging",
          "database_id": "539380aa-21e6-4d8e-8059-e9f3860c38de",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "wiel@notify.zouantcha.com"
          ]
        }
      ]
    }
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "wiel@notify.zouantcha.com"
      ]
    }
  ]
}
