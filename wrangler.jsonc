{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zouantcha-site",
  "account_id": "0bb05130da965c096b12cc1f0637f763",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "zouantcha.com",
      "custom_domain": true
    },
    {
      "pattern": "www.zouantcha.com",
      "custom_domain": true
    },
    {
      "pattern": "migration.zouantcha.com",
      "custom_domain": true
    }
  ],
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "FIELD_NOTES_API",
      "service": "zouantcha-field-notes"
    }
  ],
  "vars": {
    "FIELD_NOTES_WORKER_URL": "https://api.zouantcha.com"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "zouantcha-site-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "zouantcha_site_events"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
